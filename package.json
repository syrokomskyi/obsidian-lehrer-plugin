{
  "name": "obsidian-lehrer-plugin",
  "version": "1.2.0",
  "description": "This is an assistant for learning language.",
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "lint": "cls && npx @biomejs/biome lint --write .",
    "format": "cls && npx @biomejs/biome format --write .",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "upgrade-packages": "pnpm update -r --latest"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@webgogol/core-share": "0.3.0",
    "js-yaml": "^4.1.0",
    "nanostores": "^1.0.1",
    "translate": "^3.0.1",
    "tseep": "^1.3.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.1",
    "@types/uuid": "^10.0.0",
    "builtin-modules": "5.0.0",
    "esbuild": "0.25.2",
    "obsidian": "^1.8.7",
    "tslib": "2.8.1",
    "typescript": "5.8.3"
  }
}
